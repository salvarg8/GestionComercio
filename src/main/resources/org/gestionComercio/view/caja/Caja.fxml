<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.caja.CajaController">

    <!-- ===================================================== -->
    <!-- CABECERA -->
    <!-- ===================================================== -->

    <top>

        <HBox spacing="10"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Caja"
                   styleClass="page-title"/>

            <Label fx:id="lblEstado"
                   styleClass="estado-badge,estado-inactivo"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnAbrirOtroUsuario"
                    styleClass="btn-secondary"
                    text="Abrir caja a otro usuario"
                    visible="false"
                    managed="false"/>

            <Button fx:id="btnCajasAbiertas"
                    styleClass="btn-secondary"
                    text="Cajas abiertas"
                    visible="false"
                    managed="false"/>

            <Button fx:id="btnHistorial"
                    styleClass="btn-secondary"
                    text="Historial de cajas"/>

        </HBox>

    </top>

    <!-- ===================================================== -->
    <!-- CONTENIDO: sin caja abierta / caja abierta -->
    <!-- ===================================================== -->

    <center>

        <StackPane>

            <!-- Sin caja abierta -->

            <VBox fx:id="panelSinCaja"
                  spacing="12"
                  alignment="CENTER"
                  maxWidth="520">

                <Label text="No tiene una caja abierta"
                       styleClass="subtitle"/>

                <Label text="Para registrar movimientos de caja primero debe abrirla indicando el efectivo inicial."
                       styleClass="form-hint"
                       wrapText="true"
                       textAlignment="CENTER"/>

                <Button fx:id="btnAbrir"
                        styleClass="btn-primary"
                        defaultButton="true"
                        text="Abrir caja"/>

                <Label fx:id="lblSinPermisoAbrir"
                       text="No tiene permiso para abrir caja. Consulte con un administrador."
                       styleClass="form-warning"
                       wrapText="true"
                       visible="false"
                       managed="false"/>

            </VBox>

            <!-- Caja abierta -->

            <VBox fx:id="panelCajaAbierta"
                  spacing="12"
                  visible="false"
                  managed="false">

                <padding>
                    <Insets right="15" left="15"/>
                </padding>

                <Label fx:id="lblApertura"
                       styleClass="form-hint"/>

                <!-- Aviso de retiro / caja bloqueada (control del efectivo) -->
                <Label fx:id="lblAvisoEfectivo"
                       styleClass="form-warning"
                       wrapText="true"
                       maxWidth="Infinity"
                       visible="false"
                       managed="false"/>

                <HBox spacing="12">

                    <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Saldo inicial" styleClass="tarjeta-resumen-titulo"/>
                        <Label fx:id="lblSaldoInicial" styleClass="tarjeta-resumen-valor"/>
                    </VBox>

                    <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Ingresos" styleClass="tarjeta-resumen-titulo"/>
                        <Label fx:id="lblIngresos" styleClass="tarjeta-resumen-valor"/>
                    </VBox>

                    <VBox styleClass="tarjeta-resumen" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Egresos" styleClass="tarjeta-resumen-titulo"/>
                        <Label fx:id="lblEgresos" styleClass="tarjeta-resumen-valor"/>
                    </VBox>

                    <VBox styleClass="tarjeta-resumen,tarjeta-destacada" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Saldo actual" styleClass="tarjeta-resumen-titulo"/>
                        <Label fx:id="lblSaldoActual" styleClass="tarjeta-resumen-valor"/>
                    </VBox>

                </HBox>

                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Label text="Movimientos"
                           styleClass="subtitle"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnRegistrarMovimiento"
                            styleClass="btn-primary"
                            text="Registrar ingreso / egreso"/>

                    <Button fx:id="btnCerrar"
                            styleClass="btn-danger"
                            text="Cerrar caja"/>

                </HBox>

                <TableView fx:id="tblMovimientos"
                           styleClass="tabla-centrada"
                           VBox.vgrow="ALWAYS">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <placeholder>
                        <Label text="No hay movimientos registrados."/>
                    </placeholder>

                    <columns>

                        <TableColumn fx:id="colFecha"
                                     text="Fecha"
                                     prefWidth="130"
                                     sortable="false"/>

                        <TableColumn fx:id="colTipo"
                                     text="Tipo"
                                     prefWidth="130"
                                     sortable="false"/>

                        <TableColumn fx:id="colDescripcion"
                                     text="Descripción"
                                     prefWidth="300"
                                     sortable="false"/>

                        <TableColumn fx:id="colImporte"
                                     text="Importe"
                                     prefWidth="140"
                                     sortable="false"/>

                        <TableColumn fx:id="colUsuario"
                                     text="Usuario"
                                     prefWidth="180"
                                     sortable="false"/>

                    </columns>

                </TableView>

            </VBox>

        </StackPane>

    </center>

    <!-- ===================================================== -->
    <!-- PIE -->
    <!-- ===================================================== -->

    <bottom>

        <HBox spacing="20"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Label fx:id="lblTotal"/>

        </HBox>

    </bottom>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.caja.CajaHistorialController">

    <!-- ===================================================== -->
    <!-- CABECERA Y FILTROS -->
    <!-- ===================================================== -->

    <top>

        <VBox spacing="10">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Historial de cajas"
                       styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnVolver"
                        styleClass="btn-secondary"
                        text="Volver a la caja"/>

            </HBox>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Cerradas desde"/>

                <DatePicker fx:id="dpDesde"
                            prefWidth="140"/>

                <Label text="Hasta"/>

                <DatePicker fx:id="dpHasta"
                            prefWidth="140"/>

                <Button fx:id="btnLimpiar"
                        text="Limpiar filtros"/>

            </HBox>

        </VBox>

    </top>

    <!-- ===================================================== -->
    <!-- TABLA -->
    <!-- ===================================================== -->

    <center>

        <TableView fx:id="tblCajas" styleClass="tabla-centrada">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label fx:id="lblSinResultados" text="No hay cajas cerradas."/>
            </placeholder>

            <columns>

                <TableColumn fx:id="colApertura"
                             text="Apertura"
                             prefWidth="120"
                             sortable="false"/>

                <TableColumn fx:id="colCierre"
                             text="Cierre"
                             prefWidth="120"
                             sortable="false"/>

                <TableColumn fx:id="colUsuario"
                             text="Responsable"
                             prefWidth="170"
                             sortable="false"/>

                <TableColumn fx:id="colSaldoInicial"
                             text="Saldo inicial"
                             prefWidth="110"
                             sortable="false"/>

                <TableColumn fx:id="colIngresos"
                             text="Ingresos"
                             prefWidth="110"
                             sortable="false"/>

                <TableColumn fx:id="colEgresos"
                             text="Egresos"
                             prefWidth="110"
                             sortable="false"/>

                <TableColumn fx:id="colSaldoEsperado"
                             text="Saldo esperado"
                             prefWidth="115"
                             sortable="false"/>

                <TableColumn fx:id="colSaldoContado"
                             text="Saldo contado"
                             prefWidth="115"
                             sortable="false"/>

                <TableColumn fx:id="colDiferencia"
                             text="Diferencia"
                             prefWidth="140"
                             sortable="false"/>

                <TableColumn fx:id="colAcciones"
                             text="Acciones"
                             prefWidth="80"
                             sortable="false"/>

            </columns>

            <BorderPane.margin>
                <Insets left="15" right="15"/>
            </BorderPane.margin>

        </TableView>

    </center>

    <!-- ===================================================== -->
    <!-- PIE -->
    <!-- ===================================================== -->

    <bottom>

        <HBox spacing="20"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Label fx:id="lblTotal"
                   text="Total: 0 cajas"/>

            <Label fx:id="lblDiferenciaAcumulada"/>

        </HBox>

    </bottom>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.categoria.CategoriaFormController">

    <children>

        <VBox spacing="15.0"
              prefWidth="560"
              maxWidth="560"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="20.0">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <children>

                <Label fx:id="lblTitulo"
                       text="Nueva categoría"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <VBox spacing="5.0">

                    <children>

                        <Label text="Nombre *"/>

                        <TextField fx:id="txtNombre"
                                   promptText="Ej.: Bebidas"/>

                        <Label fx:id="lblErrorNombre"
                               styleClass="field-error-label"
                               wrapText="true"
                               visible="false"
                               managed="false"/>

                    </children>

                </VBox>

                <VBox spacing="5.0">

                    <children>

                        <Label text="Descripción"/>

                        <TextArea fx:id="txtDescripcion"
                                  promptText="Opcional"
                                  prefRowCount="4"
                                  wrapText="true"/>

                        <Label fx:id="lblErrorDescripcion"
                               styleClass="field-error-label"
                               wrapText="true"
                               visible="false"
                               managed="false"/>

                    </children>

                </VBox>

                <HBox spacing="10"
                      alignment="CENTER_RIGHT">

                    <children>

                        <Button fx:id="btnCancelar" styleClass="btn-secondary"
                                cancelButton="true"
                                text="Cancelar"/>

                        <Button fx:id="btnGuardar" styleClass="btn-primary"
                                defaultButton="true"
                                text="Guardar"/>

                    </children>

                </HBox>

            </children>

        </VBox>

    </children>

</AnchorPane>

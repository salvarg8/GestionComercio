<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.cliente.ClienteListController">

    <!-- ===================================================== -->
    <!-- CABECERA -->
    <!-- ===================================================== -->

    <top>

        <HBox spacing="10"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Clientes"
                   styleClass="page-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <ComboBox fx:id="cmbEstado"
                      prefWidth="150"/>

            <TextField fx:id="txtBuscar"
                       promptText="Buscar por nombre o documento..."
                       prefWidth="280"/>

            <Button fx:id="btnNuevo" styleClass="btn-primary"
                    text="Nuevo"/>

        </HBox>

    </top>

    <!-- ===================================================== -->
    <!-- TABLA -->
    <!-- ===================================================== -->

    <center>

        <TableView fx:id="tblClientes" styleClass="tabla-centrada">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label fx:id="lblSinResultados" text="No hay clientes cargados."/>
            </placeholder>

            <columns>

                <TableColumn fx:id="colNombre"
                             text="Nombre / Razón social"
                             prefWidth="240"/>

                <TableColumn fx:id="colDocumento"
                             text="Documento"
                             prefWidth="150"/>

                <TableColumn fx:id="colCondicionIva"
                             text="Condición IVA"
                             prefWidth="150"/>

                <TableColumn fx:id="colTelefono"
                             text="Teléfono"
                             prefWidth="130"/>

                <TableColumn fx:id="colEmail"
                             text="Email"
                             prefWidth="200"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="110"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colAcciones"
                             text="Acciones"
                             prefWidth="120"/>

            </columns>

            <BorderPane.margin>
                <Insets left="15" right="15"/>
            </BorderPane.margin>

        </TableView>

    </center>

    <!-- ===================================================== -->
    <!-- PIE -->
    <!-- ===================================================== -->

    <bottom>

        <HBox alignment="CENTER_LEFT">

            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Label fx:id="lblTotal"
                   text="Total: 0 registros"/>

        </HBox>

    </bottom>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.compra.CompraFormController">

    <!-- ===================================================== -->
    <!-- CABECERA Y DATOS DE LA COMPRA -->
    <!-- ===================================================== -->

    <top>

        <VBox spacing="12">

            <padding>
                <Insets top="15" right="15" bottom="10" left="15"/>
            </padding>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Nueva compra"
                       styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnListado"
                        styleClass="btn-secondary"
                        focusTraversable="false"
                        text="Ver compras"/>

            </HBox>

            <HBox spacing="15">

                <VBox spacing="5.0" HBox.hgrow="ALWAYS" minWidth="260">

                    <Label text="Proveedor *"/>

                    <ComboBox fx:id="cmbProveedor"
                              maxWidth="Infinity"/>

                    <Label fx:id="lblErrorProveedor"
                           styleClass="field-error-label"
                           wrapText="true"
                           visible="false"
                           managed="false"/>

                </VBox>

                <VBox spacing="5.0" prefWidth="200" minWidth="200">

                    <Label text="N° de factura"/>

                    <TextField fx:id="txtNumeroFactura"
                               promptText="Opcional. Ej.: A-0001-00001234"/>

                    <Label fx:id="lblErrorNumeroFactura"
                           styleClass="field-error-label"
                           wrapText="true"
                           visible="false"
                           managed="false"/>

                </VBox>

                <VBox spacing="5.0" prefWidth="150" minWidth="150">

                    <Label text="Fecha *"/>

                    <DatePicker fx:id="dpFecha"
                                maxWidth="Infinity"/>

                    <Label fx:id="lblErrorFecha"
                           styleClass="field-error-label"
                           wrapText="true"
                           visible="false"
                           managed="false"/>

                </VBox>

                <VBox spacing="5.0" prefWidth="180" minWidth="180">

                    <Label text="Forma de pago *"/>

                    <ComboBox fx:id="cmbFormaPago"
                              maxWidth="Infinity"/>

                    <Label fx:id="lblErrorFormaPago"
                           styleClass="field-error-label"
                           wrapText="true"
                           visible="false"
                           managed="false"/>

                </VBox>

            </HBox>

            <HBox spacing="25"
                  alignment="CENTER_LEFT">

                <CheckBox fx:id="chkPendiente"
                          text="Mercadería pendiente de recepción (no suma stock hasta recibirla)"/>

                <CheckBox fx:id="chkActualizarPrecios"
                          text="Actualizar el precio de compra de los productos"/>

            </HBox>

            <Label fx:id="lblAvisoEfectivo"
                   styleClass="form-hint"
                   wrapText="true"
                   text="El pago en efectivo se registra como egreso en su caja abierta."/>

        </VBox>

    </top>

    <!-- ===================================================== -->
    <!-- RENGLONES -->
    <!-- ===================================================== -->

    <center>

        <VBox spacing="10">

            <padding>
                <Insets right="15" left="15"/>
            </padding>

            <HBox spacing="8"
                  alignment="CENTER_LEFT">

                <TextField fx:id="txtBuscar"
                           HBox.hgrow="ALWAYS"
                           promptText="Código de barras, código interno o nombre del producto"/>

                <Label text="Cantidad"/>

                <TextField fx:id="txtCantidad"
                           prefColumnCount="5"
                           text="1"/>

                <Label text="Costo unitario"/>

                <TextField fx:id="txtCosto"
                           prefColumnCount="8"
                           promptText="Actual"/>

                <Button fx:id="btnAgregar"
                        styleClass="btn-primary"
                        text="Agregar"/>

            </HBox>

            <TableView fx:id="tblRenglones"
                       editable="true"
                       VBox.vgrow="ALWAYS">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <placeholder>
                    <Label text="Busque un producto para agregarlo a la compra."/>
                </placeholder>

                <columns>

                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="110"
                                 sortable="false"/>

                    <TableColumn fx:id="colProducto"
                                 text="Producto"
                                 prefWidth="260"
                                 sortable="false"/>

                    <TableColumn fx:id="colCantidad"
                                 text="Cantidad"
                                 prefWidth="100"
                                 sortable="false"/>

                    <TableColumn fx:id="colCosto"
                                 text="Costo unitario"
                                 prefWidth="120"
                                 sortable="false"/>

                    <TableColumn fx:id="colCostoActual"
                                 text="Costo actual"
                                 prefWidth="120"
                                 sortable="false"/>

                    <TableColumn fx:id="colSubtotal"
                                 text="Subtotal"
                                 prefWidth="120"
                                 sortable="false"/>

                    <TableColumn fx:id="colAcciones"
                                 text="Acciones"
                                 prefWidth="100"
                                 sortable="false"/>

                </columns>

            </TableView>

            <Label fx:id="lblErrorDetalles"
                   styleClass="field-error-label"
                   wrapText="true"
                   visible="false"
                   managed="false"/>

            <Label styleClass="form-hint"
                   text="Doble clic en la cantidad o el costo para modificarlos. Supr quita el renglón seleccionado."/>

        </VBox>

    </center>

    <!-- ===================================================== -->
    <!-- PIE -->
    <!-- ===================================================== -->

    <bottom>

        <HBox spacing="12"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Label fx:id="lblCantidadRenglones"
                   text="0 productos"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Total:"
                   style="-fx-font-size: 16px;"/>

            <Label fx:id="lblTotal"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Region prefWidth="20"/>

            <Button fx:id="btnCancelar"
                    styleClass="btn-secondary"
                    cancelButton="true"
                    text="Cancelar"/>

            <Button fx:id="btnGuardar"
                    styleClass="btn-primary"
                    text="Registrar compra"/>

        </HBox>

    </bottom>

</BorderPane>

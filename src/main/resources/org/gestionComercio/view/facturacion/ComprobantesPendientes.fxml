<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.facturacion.ComprobantesPendientesController">

    <top>

        <VBox spacing="10">

            <padding>
                <Insets top="15" right="15" bottom="10" left="15"/>
            </padding>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Comprobantes pendientes de CAE"
                       styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnConfiguracion"
                        styleClass="btn-secondary"
                        text="Configuración de ARCA"/>

                <Button fx:id="btnActualizar"
                        styleClass="btn-secondary"
                        text="Actualizar"/>

            </HBox>

            <Label text="Facturas y notas de crédito que todavía no tienen CAE. &quot;Pendiente&quot;: no se pudo enviar (por ejemplo, sin conexión). &quot;Enviado, sin respuesta&quot;: se envió y no llegó la respuesta; al reintentar primero se verifica en ARCA, así nunca se duplica. &quot;Rechazado&quot;: corrija el motivo (por ejemplo, el CUIT o la condición frente al IVA del cliente) y reintente."
                   styleClass="form-hint"
                   wrapText="true"/>

            <Label fx:id="lblAviso"
                   styleClass="form-warning"
                   wrapText="true"
                   maxWidth="Infinity"
                   visible="false"
                   managed="false"/>

        </VBox>

    </top>

    <center>

        <TableView fx:id="tblComprobantes">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label text="No hay comprobantes pendientes de CAE."/>
            </placeholder>

            <columns>

                <TableColumn fx:id="colFecha" text="Fecha de la venta" prefWidth="130" sortable="false"/>

                <TableColumn fx:id="colComprobante" text="Comprobante" prefWidth="200" sortable="false"/>

                <TableColumn fx:id="colCliente" text="Cliente" prefWidth="170" sortable="false"/>

                <TableColumn fx:id="colTotal" text="Total" prefWidth="110" sortable="false"/>

                <TableColumn fx:id="colEstado" text="Estado" prefWidth="170" sortable="false"/>

                <TableColumn fx:id="colIntento" text="Último intento" prefWidth="130" sortable="false"/>

                <TableColumn fx:id="colObservaciones" text="Motivo / observaciones" prefWidth="320" sortable="false"/>

            </columns>

            <BorderPane.margin>
                <Insets left="15" right="15"/>
            </BorderPane.margin>

        </TableView>

    </center>

    <bottom>

        <HBox spacing="10"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Label fx:id="lblCantidad"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnReintentar"
                    styleClass="btn-secondary"
                    text="Reintentar el seleccionado"/>

            <Button fx:id="btnReintentarTodos"
                    styleClass="btn-primary"
                    text="Reintentar todos los pendientes"/>

        </HBox>

    </bottom>

</BorderPane>

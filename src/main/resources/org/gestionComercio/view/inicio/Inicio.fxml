<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.inicio.InicioController"
            fitToWidth="true"
            styleClass="form-scroll">

    <VBox spacing="20">

        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>

        <!-- ===================================================== -->
        <!-- CABECERA -->
        <!-- ===================================================== -->

        <HBox spacing="10"
              alignment="CENTER_LEFT">

            <VBox spacing="2">

                <Label fx:id="lblSaludo"
                       styleClass="page-title"/>

                <Label fx:id="lblFecha"
                       styleClass="form-hint"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnActualizar"
                    styleClass="btn-secondary"
                    text="Actualizar"/>

        </HBox>

        <!-- ===================================================== -->
        <!-- RESUMEN DEL DÍA -->
        <!-- ===================================================== -->

        <VBox fx:id="seccionResumen"
              spacing="10">

            <Label text="Resumen del día"
                   styleClass="subtitle"/>

            <FlowPane hgap="12"
                      vgap="12">

                <VBox fx:id="tarjetaVentasCantidad"
                      styleClass="tarjeta-resumen,tarjeta-inicio">
                    <Label fx:id="lblVentasCantidadTitulo" styleClass="tarjeta-resumen-titulo"/>
                    <Label fx:id="lblVentasCantidad" styleClass="tarjeta-resumen-valor"/>
                    <Label fx:id="lblVentasAlcance" styleClass="tarjeta-resumen-detalle"/>
                </VBox>

                <VBox fx:id="tarjetaVentasImporte"
                      styleClass="tarjeta-resumen,tarjeta-destacada,tarjeta-inicio">
                    <Label fx:id="lblVentasImporteTitulo" styleClass="tarjeta-resumen-titulo"/>
                    <Label fx:id="lblVentasImporte" styleClass="tarjeta-resumen-valor"/>
                    <Label text="Sin anuladas · todas las formas de pago" styleClass="tarjeta-resumen-detalle"/>
                </VBox>

                <VBox fx:id="tarjetaCaja"
                      styleClass="tarjeta-resumen,tarjeta-inicio">
                    <Label text="Mi caja" styleClass="tarjeta-resumen-titulo"/>
                    <Label fx:id="lblCajaEstado" styleClass="tarjeta-resumen-valor"/>
                    <Label fx:id="lblCajaDetalle" styleClass="tarjeta-resumen-detalle"/>
                </VBox>

                <VBox fx:id="tarjetaStockBajo"
                      styleClass="tarjeta-resumen,tarjeta-inicio">
                    <Label text="Productos con stock bajo" styleClass="tarjeta-resumen-titulo"/>
                    <Label fx:id="lblStockBajo" styleClass="tarjeta-resumen-valor"/>
                    <Label text="En el mínimo o por debajo" styleClass="tarjeta-resumen-detalle"/>
                </VBox>

                <VBox fx:id="tarjetaSinStock"
                      styleClass="tarjeta-resumen,tarjeta-inicio">
                    <Label text="Productos sin stock" styleClass="tarjeta-resumen-titulo"/>
                    <Label fx:id="lblSinStock" styleClass="tarjeta-resumen-valor"/>
                    <Label text="Stock en cero o negativo" styleClass="tarjeta-resumen-detalle"/>
                </VBox>

            </FlowPane>

        </VBox>

        <!-- ===================================================== -->
        <!-- VENTAS POR CAJA (sólo con VENTA_VER) -->
        <!-- ===================================================== -->

        <VBox fx:id="seccionVentasPorCaja"
              spacing="10">

            <Label text="Ventas de hoy por caja"
                   styleClass="subtitle"/>

            <TableView fx:id="tblVentasPorCaja"
                       styleClass="tabla-centrada"
                       maxWidth="900">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <placeholder>
                    <Label text="No hay cajas abiertas ni ventas hoy."/>
                </placeholder>

                <columns>

                    <TableColumn fx:id="colCajaUsuario"
                                 text="Caja de"
                                 prefWidth="220"
                                 sortable="false"/>

                    <TableColumn fx:id="colCajaApertura"
                                 text="Apertura"
                                 prefWidth="140"
                                 sortable="false"/>

                    <TableColumn fx:id="colCajaEstado"
                                 text="Estado"
                                 prefWidth="110"
                                 sortable="false"/>

                    <TableColumn fx:id="colCajaCantidad"
                                 text="Ventas"
                                 prefWidth="90"
                                 sortable="false"/>

                    <TableColumn fx:id="colCajaTotal"
                                 text="Importe"
                                 prefWidth="140"
                                 sortable="false"/>

                </columns>

            </TableView>

        </VBox>

        <!-- ===================================================== -->
        <!-- ACCESOS RÁPIDOS -->
        <!-- ===================================================== -->

        <VBox fx:id="seccionAccesos"
              spacing="10">

            <Label text="Accesos rápidos"
                   styleClass="subtitle"/>

            <FlowPane hgap="12"
                      vgap="12">

                <Button fx:id="btnNuevaVenta"
                        styleClass="btn-primary,acceso-rapido"
                        text="Nueva venta"/>

                <Button fx:id="btnProductos"
                        styleClass="btn-secondary,acceso-rapido"
                        text="Productos"/>

                <Button fx:id="btnInventario"
                        styleClass="btn-secondary,acceso-rapido"
                        text="Inventario"/>

            </FlowPane>

        </VBox>

        <Label fx:id="lblSinContenido"
               text="Use el menú de la izquierda para comenzar."
               styleClass="form-hint"
               visible="false"
               managed="false"/>

    </VBox>

</ScrollPane>

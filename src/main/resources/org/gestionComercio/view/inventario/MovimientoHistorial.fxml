<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.inventario.MovimientoHistorialController">

    <!-- ===================================================== -->
    <!-- CABECERA Y FILTROS -->
    <!-- ===================================================== -->

    <top>

        <VBox spacing="10">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Historial de movimientos"
                       styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblStockActual"
                       styleClass="estado-badge,estado-inactivo"
                       visible="false"
                       managed="false"/>

            </HBox>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <ComboBox fx:id="cmbProducto"
                          prefWidth="320"/>

                <ComboBox fx:id="cmbTipo"
                          prefWidth="150"/>

                <Label text="Desde"/>

                <DatePicker fx:id="dpDesde"
                            prefWidth="140"/>

                <Label text="Hasta"/>

                <DatePicker fx:id="dpHasta"
                            prefWidth="140"/>

                <Button fx:id="btnLimpiar"
                        text="Limpiar filtros"/>

                <Region HBox.hgrow="ALWAYS"/>

                <CheckBox fx:id="chkCronologico"
                          text="Más antiguos primero">
                    <tooltip>
                        <Tooltip text="Ordena del más antiguo al más reciente, para seguir la evolución del stock"/>
                    </tooltip>
                </CheckBox>

            </HBox>

        </VBox>

    </top>

    <!-- ===================================================== -->
    <!-- TABLA -->
    <!-- ===================================================== -->

    <center>

        <TableView fx:id="tblMovimientos" styleClass="tabla-centrada">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label fx:id="lblSinResultados" text="No hay movimientos registrados."/>
            </placeholder>

            <columns>

                <TableColumn fx:id="colFecha"
                             text="Fecha"
                             prefWidth="120"
                             sortable="false"/>

                <TableColumn fx:id="colProducto"
                             text="Producto"
                             prefWidth="230"
                             sortable="false"/>

                <TableColumn fx:id="colTipo"
                             text="Tipo"
                             prefWidth="90"
                             sortable="false"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colCantidad"
                             text="Cantidad"
                             prefWidth="90"
                             sortable="false"/>

                <TableColumn fx:id="colStockAnterior"
                             text="Stock anterior"
                             prefWidth="105"
                             sortable="false"/>

                <TableColumn fx:id="colStockResultante"
                             text="Stock resultante"
                             prefWidth="115"
                             sortable="false"/>

                <TableColumn fx:id="colMotivo"
                             text="Motivo"
                             prefWidth="230"
                             sortable="false"/>

                <TableColumn fx:id="colOrigen"
                             text="Origen"
                             prefWidth="120"
                             sortable="false"/>

                <TableColumn fx:id="colUsuario"
                             text="Usuario"
                             prefWidth="160"
                             sortable="false"/>

            </columns>

            <BorderPane.margin>
                <Insets left="15" right="15"/>
            </BorderPane.margin>

        </TableView>

    </center>

    <!-- ===================================================== -->
    <!-- PIE -->
    <!-- ===================================================== -->

    <bottom>

        <HBox spacing="20"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Label fx:id="lblTotal"
                   text="Total: 0 movimientos"/>

        </HBox>

    </bottom>

</BorderPane>

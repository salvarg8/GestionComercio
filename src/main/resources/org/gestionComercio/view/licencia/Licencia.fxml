<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.licencia.LicenciaController"
            fitToWidth="true"
            styleClass="form-scroll">

    <content>

        <VBox spacing="15.0"
              prefWidth="820"
              maxWidth="820">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <children>

                <Label text="Licencia"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <Label text="La licencia es del comercio y vale para todas sus PC: indica hasta cuándo se puede usar el sistema, qué módulos incluye y en qué PC funciona."
                       styleClass="form-hint"
                       wrapText="true"/>

                <!-- ============================================= -->
                <!-- ESTADO -->
                <!-- ============================================= -->

                <Label fx:id="lblEstado"
                       wrapText="true"
                       maxWidth="Infinity"/>

                <GridPane fx:id="gridDatos" hgap="15" vgap="8">

                    <columnConstraints>
                        <ColumnConstraints minWidth="150" prefWidth="150"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <children>

                        <Label text="Cliente" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblCliente" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="CUIT" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblCuit" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Modalidad" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lblModalidad" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Módulos" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="lblModulos" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="PC habilitadas" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="lblEquipos" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Emitida" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <Label fx:id="lblEmitida" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    </children>

                </GridPane>

                <Separator/>

                <!-- ============================================= -->
                <!-- CÓDIGO DE ESTA PC -->
                <!-- ============================================= -->

                <VBox spacing="8.0">

                    <children>

                        <Label text="Código de esta PC" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                        <HBox spacing="8" alignment="CENTER_LEFT">

                            <children>

                                <TextField fx:id="txtCodigoEquipo"
                                           editable="false"
                                           prefWidth="260"
                                           style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 15px;"/>

                                <Button fx:id="btnCopiarCodigo"
                                        styleClass="btn-secondary"
                                        text="Copiar"/>

                            </children>

                        </HBox>

                        <Label text="Para habilitar una PC nueva o reemplazar una que se cambió, envíe a su proveedor el código de cada PC que va a usar el sistema. Recibirá una licencia nueva con la lista actualizada, que reemplaza a la anterior y se activa una sola vez desde cualquiera de esas PC."
                               styleClass="form-hint"
                               wrapText="true"/>

                    </children>

                </VBox>

                <Separator/>

                <!-- ============================================= -->
                <!-- ACTIVAR -->
                <!-- ============================================= -->

                <VBox spacing="8.0">

                    <children>

                        <Label text="Activar una licencia" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                        <Label text="Cargue el archivo de licencia (.lic) que le envió su proveedor, o pegue la clave."
                               styleClass="form-hint"
                               wrapText="true"/>

                        <TextArea fx:id="txtClave"
                                  prefRowCount="5"
                                  wrapText="true"
                                  promptText="GC1.…"/>

                        <HBox spacing="8" alignment="CENTER_RIGHT">

                            <children>

                                <Button fx:id="btnCargarArchivo"
                                        styleClass="btn-secondary"
                                        text="Cargar archivo…"/>

                                <Button fx:id="btnActivar"
                                        styleClass="btn-primary"
                                        text="Activar licencia"/>

                            </children>

                        </HBox>

                    </children>

                </VBox>

            </children>

        </VBox>

    </content>

</ScrollPane>

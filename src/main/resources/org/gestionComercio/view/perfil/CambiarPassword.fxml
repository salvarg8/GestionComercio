<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.perfil.CambiarPasswordController">

    <children>

        <VBox spacing="15.0"
              prefWidth="420"
              maxWidth="420"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="20.0">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <children>

                <Label text="Cambiar contraseña"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <VBox spacing="5">
                    <Label text="Contraseña actual *"/>
                    <PasswordField fx:id="txtPasswordActual"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Nueva contraseña *"/>
                    <PasswordField fx:id="txtPasswordNueva"/>
                    <Label text="Mínimo 6 caracteres."
                           style="-fx-font-size: 11px; -fx-opacity: 0.75;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Confirmar nueva contraseña *"/>
                    <PasswordField fx:id="txtPasswordConfirmacion"/>
                </VBox>

                <HBox spacing="10"
                      alignment="CENTER_RIGHT">

                    <children>

                        <Button fx:id="btnLimpiar"
                                text="Limpiar"/>

                        <Button fx:id="btnGuardar"
                                defaultButton="true"
                                text="Cambiar contraseña"/>

                    </children>

                </HBox>

            </children>

        </VBox>

    </children>

</AnchorPane>

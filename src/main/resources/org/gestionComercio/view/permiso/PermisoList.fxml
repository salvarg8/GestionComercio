<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.permiso.PermisoListController">

    <!-- ==================== CABECERA ==================== -->

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Gestión de Permisos"
                   styleClass="page-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtBuscar"
                       promptText="Buscar por código o descripción..."
                       prefWidth="300"/>
        </HBox>
    </top>

    <!-- ==================== TABLA ==================== -->

    <center>
        <TableView fx:id="tblPermisos"
                   BorderPane.alignment="CENTER">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <columns>

                <TableColumn fx:id="colCodigo"
                             text="Código"
                             prefWidth="250"/>

                <TableColumn fx:id="colDescripcion"
                             text="Descripción"
                             prefWidth="450"/>

            </columns>

            <BorderPane.margin>
                <Insets left="15" right="15"/>
            </BorderPane.margin>

        </TableView>
    </center>

    <!-- ==================== PIE ==================== -->

    <bottom>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="10"
                        right="15"
                        bottom="15"
                        left="15"/>
            </padding>

            <Label fx:id="lblTotal"
                   text="Total: 0 permisos"/>
        </HBox>
    </bottom>

</BorderPane>
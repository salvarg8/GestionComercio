<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.producto.ProductoListController">

    <!-- ===================================================== -->
    <!-- CABECERA -->
    <!-- ===================================================== -->

    <top>

        <HBox spacing="10"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Productos"
                   styleClass="page-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <ComboBox fx:id="cmbEstado"
                      prefWidth="150"/>

            <TextField fx:id="txtBuscar"
                       promptText="Buscar por nombre, código o código de barras..."
                       prefWidth="340"/>

            <Button fx:id="btnNuevo" styleClass="btn-primary"
                    text="Nuevo"/>

        </HBox>

    </top>

    <!-- ===================================================== -->
    <!-- TABLA -->
    <!-- ===================================================== -->

    <center>

        <TableView fx:id="tblProductos" styleClass="tabla-centrada">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label fx:id="lblSinResultados" text="No hay productos cargados."/>
            </placeholder>

            <columns>

                <TableColumn fx:id="colCodigo"
                             text="Código"
                             prefWidth="90"/>

                <TableColumn fx:id="colCodigoBarras"
                             text="Cód. de barras"
                             prefWidth="120"/>

                <TableColumn fx:id="colNombre"
                             text="Nombre"
                             prefWidth="240"/>

                <TableColumn fx:id="colCategoria"
                             text="Categoría"
                             prefWidth="130"/>

                <TableColumn fx:id="colMarca"
                             text="Marca"
                             prefWidth="120"/>

                <TableColumn fx:id="colPrecioCompra"
                             text="P. compra"
                             prefWidth="105"/>

                <TableColumn fx:id="colPrecioVenta"
                             text="P. venta"
                             prefWidth="105"/>

                <TableColumn fx:id="colStock"
                             text="Stock"
                             prefWidth="110"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="110"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colAcciones"
                             text="Acciones"
                             prefWidth="110"/>

            </columns>

            <BorderPane.margin>
                <Insets left="15" right="15"/>
            </BorderPane.margin>

        </TableView>

    </center>

    <!-- ===================================================== -->
    <!-- PIE -->
    <!-- ===================================================== -->

    <bottom>

        <HBox spacing="20"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Label fx:id="lblTotal"
                   text="Total: 0 registros"/>

            <Label fx:id="lblStockBajo"
                   styleClass="estado-badge,stock-bajo"
                   visible="false"
                   managed="false"/>

        </HBox>

    </bottom>

</BorderPane>

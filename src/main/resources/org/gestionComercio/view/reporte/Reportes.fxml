<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.reporte.ReportesController">

    <!-- ===================================================== -->
    <!-- CABECERA Y FILTROS -->
    <!-- ===================================================== -->

    <top>

        <VBox spacing="10">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Reportes"
                       styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnExportarPdf"
                        styleClass="btn-secondary"
                        text="Exportar a PDF"/>

                <Button fx:id="btnExportarExcel"
                        styleClass="btn-secondary"
                        text="Exportar a Excel"/>

            </HBox>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Reporte"/>

                <ComboBox fx:id="cmbReporte"
                          prefWidth="300"/>

                <Label fx:id="lblDesde"
                       text="Desde"/>

                <DatePicker fx:id="dpDesde"
                            prefWidth="140"/>

                <Label fx:id="lblHasta"
                       text="Hasta"/>

                <DatePicker fx:id="dpHasta"
                            prefWidth="140"/>

                <Button fx:id="btnActualizar"
                        styleClass="btn-primary"
                        text="Actualizar"/>

            </HBox>

            <Label fx:id="lblDetalle"
                   styleClass="form-hint"
                   wrapText="true"/>

        </VBox>

    </top>

    <!-- ===================================================== -->
    <!-- TABLA -->
    <!-- ===================================================== -->

    <center>

        <TableView fx:id="tblReporte"
                   styleClass="tabla-reporte">

            <placeholder>
                <Label fx:id="lblSinDatos"
                       text="Seleccione un reporte."/>
            </placeholder>

            <BorderPane.margin>
                <Insets left="15" right="15"/>
            </BorderPane.margin>

        </TableView>

    </center>

    <!-- ===================================================== -->
    <!-- PIE -->
    <!-- ===================================================== -->

    <bottom>

        <HBox spacing="20"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Label fx:id="lblResumen"/>

        </HBox>

    </bottom>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="700.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.rol.RolFormController">

    <children>

        <VBox spacing="15.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.bottomAnchor="20.0">

            <children>

                <Label fx:id="lblTitulo"
                       text="Rol"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                <Label fx:id="lblSoloLectura"
                       text="Puede ver los permisos del rol, pero no modificarlos."
                       styleClass="form-hint"
                       visible="false"
                       managed="false"/>

                <VBox spacing="5.0">

                    <children>

                        <Label text="Nombre *"/>

                        <TextField fx:id="txtNombre"
                                   promptText="Ingrese el nombre del rol"/>

                    </children>

                </VBox>

                <VBox spacing="5.0">

                    <children>

                        <Label text="Descripción"/>

                        <TextArea fx:id="txtDescripcion"
                                  promptText="Ingrese una descripción"
                                  prefRowCount="3"
                                  wrapText="true"/>

                    </children>

                </VBox>

                <VBox spacing="5.0"
                      VBox.vgrow="ALWAYS">

                    <children>

                        <HBox spacing="10" alignment="CENTER_LEFT">

                            <children>

                                <Label text="Permisos"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label fx:id="lblResumen"
                                       styleClass="form-hint"/>

                            </children>

                        </HBox>

                        <TextField fx:id="txtBuscarPermiso"
                                   promptText="Buscar por módulo o permiso"/>

                        <Label fx:id="lblAyudaModulos"
                               text="Tilde un módulo para darle todos sus permisos (o todos los que coinciden con la búsqueda)."
                               styleClass="form-hint"
                               wrapText="true"/>

                        <TreeView fx:id="treePermisos"
                                  showRoot="false"
                                  VBox.vgrow="ALWAYS"/>

                    </children>

                </VBox>

                <HBox spacing="10"
                      alignment="CENTER_RIGHT">

                    <children>

                        <Button fx:id="btnCancelar" styleClass="btn-secondary"
                                text="Cancelar"/>

                        <Button fx:id="btnGuardar" styleClass="btn-primary"
                                defaultButton="true"
                                text="Guardar"/>

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

        </VBox>

    </children>

</AnchorPane>

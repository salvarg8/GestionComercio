<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.usuario.UsuarioListController">

    <!-- ===================================================== -->
    <!-- CABECERA -->
    <!-- ===================================================== -->

    <top>

        <HBox spacing="10"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Usuarios"
                   styleClass="page-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtBuscar"
                       promptText="Buscar por usuario, nombre o documento..."
                       prefWidth="300"/>

            <Button fx:id="btnNuevo" styleClass="btn-primary"
                    text="Nuevo"/>

        </HBox>

    </top>

    <!-- ===================================================== -->
    <!-- TABLA -->
    <!-- ===================================================== -->

    <center>

        <TableView fx:id="tblUsuarios">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <columns>

                <TableColumn fx:id="colUsuario"
                             text="Usuario"
                             prefWidth="140"/>

                <TableColumn fx:id="colNombre"
                             text="Apellido y nombre"
                             prefWidth="240"/>

                <TableColumn fx:id="colDocumento"
                             text="Documento"
                             prefWidth="150"/>

                <TableColumn fx:id="colRol"
                             text="Rol"
                             prefWidth="140"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="100"/>

                <TableColumn fx:id="colAcciones"
                             text="Acciones"
                             prefWidth="120"/>

            </columns>

            <BorderPane.margin>
                <Insets left="15" right="15"/>
            </BorderPane.margin>

        </TableView>

    </center>

    <!-- ===================================================== -->
    <!-- PIE -->
    <!-- ===================================================== -->

    <bottom>

        <HBox alignment="CENTER_LEFT">

            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Label fx:id="lblTotal"
                   text="Total: 0 registros"/>

        </HBox>

    </bottom>

</BorderPane>

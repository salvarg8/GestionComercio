<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.venta.PuntoVentaController">

    <!-- ===================================================== -->
    <!-- CABECERA -->
    <!-- ===================================================== -->

    <top>

        <HBox spacing="10"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="15" right="15" bottom="10" left="15"/>
            </padding>

            <Label text="Punto de venta"
                   styleClass="page-title"/>

            <Label fx:id="lblCaja"
                   styleClass="estado-badge,estado-inactivo"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnHistorial"
                    styleClass="btn-secondary"
                    focusTraversable="false"
                    text="Historial de ventas"/>

        </HBox>

    </top>

    <center>

        <StackPane>

            <!-- ===================================================== -->
            <!-- SIN CAJA ABIERTA -->
            <!-- ===================================================== -->

            <VBox fx:id="panelSinCaja"
                  spacing="12"
                  alignment="CENTER"
                  maxWidth="520"
                  visible="false"
                  managed="false">

                <Label text="No tiene una caja abierta"
                       styleClass="subtitle"/>

                <Label text="Las ventas se registran en la caja abierta del vendedor. Abra la caja para empezar a vender."
                       styleClass="form-hint"
                       wrapText="true"
                       textAlignment="CENTER"/>

                <Button fx:id="btnIrACaja"
                        styleClass="btn-primary"
                        defaultButton="true"
                        text="Ir a la caja"/>

                <Label fx:id="lblSinAccesoCaja"
                       text="No tiene acceso a la caja. Pida a un administrador que la abra o le dé permiso."
                       styleClass="form-warning"
                       wrapText="true"
                       visible="false"
                       managed="false"/>

                <Button fx:id="btnReintentar"
                        styleClass="btn-secondary"
                        text="Volver a verificar"/>

            </VBox>

            <!-- ===================================================== -->
            <!-- VENTA -->
            <!-- ===================================================== -->

            <BorderPane fx:id="panelVenta">

                <!-- Carrito -->

                <center>

                    <VBox spacing="10">

                        <padding>
                            <Insets right="10" left="15"/>
                        </padding>

                        <HBox spacing="8"
                              alignment="CENTER_LEFT">

                            <TextField fx:id="txtBuscar"
                                       HBox.hgrow="ALWAYS"
                                       promptText="Código de barras, código interno o nombre del producto  (F2)"/>

                            <Label text="Cantidad"/>

                            <TextField fx:id="txtCantidad"
                                       prefColumnCount="5"
                                       text="1"/>

                            <Button fx:id="btnAgregar"
                                    styleClass="btn-primary"
                                    focusTraversable="false"
                                    text="Agregar"/>

                        </HBox>

                        <TableView fx:id="tblCarrito"
                                   editable="true"
                                   VBox.vgrow="ALWAYS">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <placeholder>
                                <Label text="Escanee o busque un producto para empezar la venta."/>
                            </placeholder>

                            <columns>

                                <TableColumn fx:id="colCodigo"
                                             text="Código"
                                             prefWidth="100"
                                             sortable="false"/>

                                <TableColumn fx:id="colProducto"
                                             text="Producto"
                                             prefWidth="260"
                                             sortable="false"/>

                                <TableColumn fx:id="colCantidad"
                                             text="Cantidad"
                                             prefWidth="90"
                                             sortable="false"/>

                                <TableColumn fx:id="colPrecio"
                                             text="Precio unitario"
                                             prefWidth="115"
                                             sortable="false"/>

                                <TableColumn fx:id="colSubtotal"
                                             text="Subtotal"
                                             prefWidth="115"
                                             sortable="false"/>

                                <TableColumn fx:id="colDisponible"
                                             text="Disponible"
                                             prefWidth="120"
                                             sortable="false"/>

                                <TableColumn fx:id="colAcciones"
                                             text="Acciones"
                                             prefWidth="80"
                                             sortable="false"/>

                            </columns>

                        </TableView>

                        <Label fx:id="lblAvisoStock"
                               styleClass="form-warning"
                               wrapText="true"
                               visible="false"
                               managed="false"/>

                        <Label styleClass="form-hint"
                               wrapText="true"
                               text="F2 buscar · F3 cambiar cantidad · + / − sumar o restar · Supr quitar renglón · F4 cliente · F5 forma de pago · F6 descuento · F7 paga con · F8 vaciar · F12 confirmar"/>

                    </VBox>

                </center>

                <!-- Cobro -->

                <right>

                    <VBox spacing="10"
                          prefWidth="330"
                          styleClass="tarjeta-resumen">

                        <BorderPane.margin>
                            <Insets right="15" bottom="15"/>
                        </BorderPane.margin>

                        <Label text="Comprobante  (F9)"/>

                        <ComboBox fx:id="cmbTipoComprobante"
                                  maxWidth="Infinity"/>

                        <Label text="Cliente  (F4)"/>

                        <ComboBox fx:id="cmbCliente"
                                  maxWidth="Infinity"/>

                        <Label text="Forma de pago  (F5)"/>

                        <ComboBox fx:id="cmbFormaPago"
                                  maxWidth="Infinity"/>

                        <Separator/>

                        <GridPane hgap="10" vgap="8">

                            <columnConstraints>
                                <ColumnConstraints/>
                                <ColumnConstraints hgrow="ALWAYS" halignment="RIGHT"/>
                            </columnConstraints>

                            <Label text="Subtotal"
                                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="lblSubtotal"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Descuento ($)  (F6)"
                                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="txtDescuento"
                                       promptText="0,00"
                                       alignment="CENTER_RIGHT"
                                       prefColumnCount="9"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        </GridPane>

                        <Separator/>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="TOTAL"
                                   styleClass="tarjeta-resumen-titulo"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblTotal"
                                   style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                        </HBox>

                        <GridPane fx:id="panelEfectivo"
                                  hgap="10"
                                  vgap="8">

                            <columnConstraints>
                                <ColumnConstraints/>
                                <ColumnConstraints hgrow="ALWAYS" halignment="RIGHT"/>
                            </columnConstraints>

                            <Label text="Paga con  (F7)"
                                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <TextField fx:id="txtPagaCon"
                                       promptText="Importe recibido"
                                       alignment="CENTER_RIGHT"
                                       prefColumnCount="9"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Vuelto"
                                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="lblVuelto"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold;"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        </GridPane>

                        <Label fx:id="lblError"
                               styleClass="field-error-label"
                               wrapText="true"/>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button fx:id="btnConfirmar"
                                styleClass="btn-primary"
                                maxWidth="Infinity"
                                style="-fx-font-size: 15px;"
                                text="Confirmar venta  (F12)"/>

                        <Button fx:id="btnVaciar"
                                styleClass="btn-secondary"
                                maxWidth="Infinity"
                                text="Vaciar venta  (F8)"/>

                    </VBox>

                </right>

            </BorderPane>

        </StackPane>

    </center>

</BorderPane>

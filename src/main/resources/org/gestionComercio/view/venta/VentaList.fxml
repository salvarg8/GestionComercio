<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gestionComercio.controller.venta.VentaListController">

    <!-- ===================================================== -->
    <!-- CABECERA Y FILTROS -->
    <!-- ===================================================== -->

    <top>

        <VBox spacing="10">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Ventas"
                       styleClass="page-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnNuevaVenta"
                        styleClass="btn-primary"
                        text="Nueva venta"/>

            </HBox>

            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Desde"/>

                <DatePicker fx:id="dpDesde"
                            prefWidth="140"/>

                <Label text="Hasta"/>

                <DatePicker fx:id="dpHasta"
                            prefWidth="140"/>

                <Label text="Cliente"/>

                <TextField fx:id="txtCliente"
                           prefColumnCount="18"
                           promptText="Nombre o &quot;consumidor final&quot;"/>

                <Label text="Estado"/>

                <ComboBox fx:id="cmbEstado"
                          prefWidth="160"/>

                <Button fx:id="btnLimpiar"
                        text="Limpiar filtros"/>

            </HBox>

        </VBox>

    </top>

    <!-- ===================================================== -->
    <!-- TABLA -->
    <!-- ===================================================== -->

    <center>

        <TableView fx:id="tblVentas" styleClass="tabla-centrada">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <placeholder>
                <Label fx:id="lblSinResultados" text="No hay ventas."/>
            </placeholder>

            <columns>

                <TableColumn fx:id="colNumero"
                             text="Comprobante"
                             prefWidth="150"
                             sortable="false"/>

                <TableColumn fx:id="colFecha"
                             text="Fecha"
                             prefWidth="130"
                             sortable="false"/>

                <TableColumn fx:id="colCliente"
                             text="Cliente"
                             prefWidth="200"
                             sortable="false"/>

                <TableColumn fx:id="colVendedor"
                             text="Vendedor"
                             prefWidth="170"
                             sortable="false"/>

                <TableColumn fx:id="colFormaPago"
                             text="Forma de pago"
                             prefWidth="140"
                             sortable="false"/>

                <TableColumn fx:id="colTotal"
                             text="Total"
                             prefWidth="120"
                             sortable="false"/>

                <TableColumn fx:id="colEstado"
                             text="Estado"
                             prefWidth="110"
                             sortable="false"/>

                <TableColumn fx:id="colAcciones"
                             text="Acciones"
                             prefWidth="130"
                             sortable="false"/>

            </columns>

            <BorderPane.margin>
                <Insets left="15" right="15"/>
            </BorderPane.margin>

        </TableView>

    </center>

    <!-- ===================================================== -->
    <!-- PIE -->
    <!-- ===================================================== -->

    <bottom>

        <HBox spacing="20"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>

            <Label fx:id="lblCantidad"
                   text="Total: 0 ventas"/>

            <Label fx:id="lblImporte"/>

        </HBox>

    </bottom>

</BorderPane>
